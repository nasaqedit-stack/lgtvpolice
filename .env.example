# Supabase project (public values may be exposed; service role and S3 keys must remain server-only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage S3-compatible endpoint and server-side credentials.
# Create access keys in Supabase Project Settings -> Storage -> S3 Connection.
SUPABASE_S3_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=your-storage-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-storage-secret-access-key
SIGNAGE_STORAGE_BUCKET=signage-media

# Optional. Used to hash source IPs for pairing rate limits; use a long random value.
PAIRING_RATE_LIMIT_SALT=replace-with-a-long-random-secret
# Optional. Separate salt for public submission (/submit) rate limits and IP hashing.
# Falls back to PAIRING_RATE_LIMIT_SALT when unset.
SUBMISSION_RATE_LIMIT_SALT=replace-with-another-long-random-secret
CRON_SECRET=replace-with-a-different-long-random-secret

# Public application origin, e.g. https://signage.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
